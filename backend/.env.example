DOCUMIND_APP_NAME=DocuMind API
DOCUMIND_ENVIRONMENT=local
DOCUMIND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Microsoft Foundry project endpoint and existing published prompt agent.
# Authentication uses DefaultAzureCredential; no key or secret is stored here.
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_FOUNDRY_AGENT_NAME=documindai

# Backward-compatible aliases accepted by the backend.
AZURE_FOUNDRY_PROJECT=
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_AGENT_ID=

# Foundry owns the connected knowledge base and Azure AI Search retrieval.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=
